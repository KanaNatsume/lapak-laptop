PORT=3000
DATABASE_PATH=./data/pos.sqlite
DEFAULT_ADMIN_PASSWORD=change-this-to-a-long-password
CORS_ORIGIN=http://localhost:5173
TRUST_CLOUDFLARE_IP_HEADER=false
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
BACKUP_DIR=data/backups
BACKUP_INTERVAL_MS=86400000
BACKUP_RETENTION_DAYS=30
BACKUP_MIRROR_HOST_PATH=pos_backup_mirror
# Optional stable 32-byte AES key as 64 hex characters; otherwise a protected .pin-key file is generated beside the database.
SERVICE_PIN_ENCRYPTION_KEY=